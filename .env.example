# Copy to .env.local and fill in. Without these, development stores bouquets in
# .data/bouquets.json and production refuses to save (so nothing is ever lost).

# Upstash Redis (free tier is plenty): https://console.upstash.com -> Create database -> REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# If you connect Upstash through the Vercel Marketplace instead, it sets
# KV_REST_API_URL and KV_REST_API_TOKEN, which also work. Nothing to copy.

# The public address, used for absolute link-preview image URLs.
# Not needed on Vercel (VERCEL_PROJECT_PRODUCTION_URL is used automatically).
SITE_URL=
